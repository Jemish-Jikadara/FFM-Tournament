NODE_ENV=development
PORT=3000

# MongoDB: local install OR a free MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/clashiq

# Change these two in production (use long random strings)
JWT_SECRET=change-this-to-a-long-random-secret
COOKIE_SECRET=change-this-to-another-long-random-secret
JWT_EXPIRES_IN=7d

# Used to AES-256-GCM encrypt match room ID / password in the database
ROOM_ENCRYPTION_KEY=change-this-room-encryption-key

# Timezone used for match times shown/entered in the UI
APP_TIMEZONE=Asia/Kolkata
APP_TZ_OFFSET=+05:30

# Test wallet mode: "Add Cash" credits instantly with NO real payment.
# Set to false once you integrate a real payment gateway.
TEST_MODE_DEPOSITS=true

# Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@clashiq.gg
SEED_ADMIN_PASSWORD=Admin@123
