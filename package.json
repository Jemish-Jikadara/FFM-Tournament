{
  "name": "ffm-free-fire-platform",
  "version": "2.0.0",
  "description": "FFM - Free Fire tournament platform. Node.js + Express + MongoDB + EJS + Tailwind CSS",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n server,css \"nodemon --watch src --watch views --ext js,ejs src/server.js\" \"npm run watch:css\"",
    "build:css": "tailwindcss -c tailwind.config.js -i ./public/css/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./public/css/input.css -o ./public/css/app.css --watch",
    "seed": "node scripts/seed.js",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-static": "^1.49.0",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.19"
  }
}
