<div class="py-8 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-6">
  <div>
    <h1 class="h1">Dispute Support</h1>
    <p class="text-xs text-[#8a7d63] mt-1">Report result errors, team problems
      or payment issues for matches you joined</p>
  </div>

  <form method="post" action="/disputes"
    class="card border-amber-500/20 bg-[#0f0c08]/80 backdrop-blur-sm p-6 space-y-4">
    <h2 class="h2">Raise a Dispute</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="label" for="match_id">Match</label>
        <select id="match_id" name="match_id" class="input">
          <option value>General (no specific match)</option>
          <% matches.forEach(function (m) { %><option value="<%= m._id %>"><%=
            m.publicMatchCode %> · <%= m.modeName %> · <%= date(m.matchStartAt)
            %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="label" for="type">Issue Type</label>
        <select id="type" name="type" class="input">
          <option value="RESULT">Match Result Discrepancy</option>
          <option value="TEAM_ASSIGNMENT">Team Assignment Error</option>
          <option value="PAYMENT">Payment / Wallet Issue</option>
          <option value="CHEATING">Suspected Cheating</option>
          <option value="OTHER">Other</option>
        </select>
      </div>
    </div>
    <div>
      <label class="label" for="description">Describe the issue</label>
      <textarea id="description" name="description" rows="4" required
        minlength="10" maxlength="2000" class="input"
        placeholder="What happened? Include room ID, timings, player names…"></textarea>
    </div>
    <button type="submit"
      class="btn-primary bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-black font-black shadow-[0_0_30px_-5px_rgba(245,200,66,0.7)] border border-amber-400">Submit
      Dispute</button>
  </form>

  <section>
    <h2 class="h2 mb-3">My Disputes</h2>
    <% if (!disputes.length) { %>
    <div
      class="rounded-xl border border-amber-500/20 bg-black/60 backdrop-blur-sm p-8 text-center text-xs text-[#8a7d63]">You
      haven't raised any disputes.</div>
    <% } else { %>
    <div class="space-y-3">
      <% disputes.forEach(function (d) { %>
      <div
        class="rounded-xl border border-amber-500/20 bg-[#0f0c08]/80 backdrop-blur-sm p-4">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="font-bold text-white"><%= d.type.replace('_', ' ')
              %></span>
            <% if (d.match) { %><span class="font-mono text-[#8a7d63]"><%=
              d.match.publicMatchCode %></span><% } %>
            <span class="text-[#8a7d63]"><%= date(d.createdAt) %></span>
          </div>
          <span
            class="rounded-full px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider <%= stateBadge(d.status) %>"><%=
            d.status %></span>
        </div>
        <p class="text-xs text-[#e8dfc9] whitespace-pre-line"><%= d.description
          %></p>
        <% if (d.resolution) { %>
        <p
          class="mt-3 rounded-lg border border-emerald-500/20 bg-emerald-500/5 p-3 text-xs text-[#e8dfc9]">
          <strong class="text-emerald-400">Admin response:</strong> <%=
          d.resolution %>
        </p>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% } %>
  </section>
</div>