<div class="py-8 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-6">

  <div>
    <h1 class="h1">My Chats</h1>
    <p class="text-xs text-[#8a7d63] mt-1">Groups you have joined</p>
  </div>

  <% if (!groups.length) { %>
    <div class="rounded-2xl border border-amber-500/20 bg-black/60 backdrop-blur-sm p-12 text-center">
      <%- icon('message-square', 'mx-auto h-12 w-12 text-amber-500/40 mb-3') %>
      <h3 class="font-bold text-lg text-white">No Chats Yet</h3>
      <p class="text-xs text-[#8a7d63] mt-1">Ask your match host for a chat invite link.</p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% groups.forEach(function(g) { %>
        <a href="/chat/<%= g._id %>" class="card border-amber-500/20 bg-[#0f0c08]/80 backdrop-blur-sm p-5 hover:border-amber-500/50 transition">
          <h3 class="font-black text-white text-base uppercase tracking-tight mb-2"><%= g.name %></h3>
          <p class="text-xs text-[#8a7d63]">Host: <%= g.host.profile && g.host.profile.displayName || g.host.email %></p>
          <p class="text-[11px] text-amber-400 font-mono mt-2"><%= g.messageCount %> messages</p>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>