<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center p-4">
  <div class="w-full max-w-md rounded-2xl border border-amber-500/20 bg-[#0f0c08]/80 p-8 shadow-2xl backdrop-blur-md">
    <div class="text-center mb-6">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-xl bg-gradient-to-br from-amber-300 to-amber-600 text-black font-black text-xl mb-4">
        <%- icon('message-square', 'h-7 w-7') %>
      </div>
      <div class="text-[10px] font-black uppercase tracking-[0.25em] text-amber-400 mb-2">Chat Invite</div>
      <h1 class="text-2xl font-black text-white uppercase tracking-tight"><%= group.name %></h1>
    </div>

    <% if (group.description) { %>
      <p class="text-sm text-[#8a7d63] text-center mb-6"><%= group.description %></p>
    <% } %>

    <div class="space-y-3 mb-6">
      <div class="flex items-center justify-between rounded-lg border border-amber-500/15 bg-black/40 p-3">
        <span class="text-[10px] font-bold uppercase text-[#8a7d63]">Host</span>
        <span class="font-bold text-white text-sm"><%= group.host.profile && group.host.profile.displayName || group.host.email %></span>
      </div>
      <div class="flex items-center justify-between rounded-lg border border-amber-500/15 bg-black/40 p-3">
        <span class="text-[10px] font-bold uppercase text-[#8a7d63]">Members</span>
        <span class="font-black text-amber-400 text-sm font-mono"><%= memberCount %></span>
      </div>
    </div>

    <div class="rounded-lg bg-amber-500/10 border border-amber-500/30 p-3 mb-6 text-xs text-amber-300">
      <%- icon('info', 'h-3.5 w-3.5 inline -mt-0.5 mr-1') %>
      You will have read-only access. Only the host can send messages.
    </div>

    <form method="post" action="/chat/join/<%= group.inviteCode %>">
      <button type="submit" class="btn-primary w-full bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-black font-black border border-amber-400 py-3">
        <%- icon('user-plus', 'h-4 w-4') %> Join Group
      </button>
    </form>

    <div class="mt-4 text-center">
      <a href="/dashboard" class="text-xs text-[#8a7d63] hover:text-amber-400">← Back to Dashboard</a>
    </div>
  </div>
</div>