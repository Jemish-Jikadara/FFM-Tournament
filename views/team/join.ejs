<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center p-4">
  <div class="w-full max-w-md rounded-2xl border border-amber-500/20 bg-[#0f0c08]/80 p-8 shadow-2xl backdrop-blur-md">

    <!-- HEADER -->
    <div class="text-center mb-8">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-xl bg-gradient-to-br from-amber-300 to-amber-600 text-black font-black text-xl mb-4">
        <%= team.name.charAt(0).toUpperCase() %>
      </div>
      <div class="text-[10px] font-black uppercase tracking-[0.25em] text-amber-400 mb-2">Team Invite</div>
      <h1 class="text-2xl font-black text-white uppercase tracking-tight"><%= team.name %></h1>
      <% if (team.tag) { %>
        <div class="text-xs font-mono text-amber-400 mt-1">[<%= team.tag %>]</div>
      <% } %>
      <% if (team.description) { %>
        <p class="text-xs text-[#8a7d63] mt-3 leading-relaxed"><%= team.description %></p>
      <% } %>
    </div>

    <!-- TEAM INFO -->
    <div class="space-y-3 mb-6">
      <div class="flex items-center justify-between rounded-lg border border-amber-500/15 bg-black/40 p-3">
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#8a7d63]">Team Leader</span>
        <span class="font-bold text-white text-sm"><%= team.igl.profile && team.igl.profile.displayName || team.igl.email %></span>
      </div>
      <div class="flex items-center justify-between rounded-lg border border-amber-500/15 bg-black/40 p-3">
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#8a7d63]">Members</span>
        <span class="font-black text-amber-400 text-sm font-mono"><%= memberCount %></span>
      </div>
      <div class="flex items-center justify-between rounded-lg border border-amber-500/15 bg-black/40 p-3">
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#8a7d63]">Your Role</span>
        <span class="font-bold text-white text-sm uppercase"><%= user.role %></span>
      </div>
    </div>

    <!-- JOIN BUTTON -->
    <form method="post" action="/team/join/<%= team.inviteCode %>">
      <button type="submit"
        class="btn-primary w-full bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-black font-black border border-amber-400 shadow-[0_0_24px_-6px_rgba(245,200,66,0.7)] py-3">
        <%- icon('user-plus', 'h-4 w-4') %> Join <%= team.name %>
      </button>
    </form>

    <div class="mt-4 text-center">
      <a href="/dashboard" class="text-xs font-bold text-[#8a7d63] hover:text-amber-400 transition">
        ← Back to Dashboard
      </a>
    </div>

  </div>
</div>