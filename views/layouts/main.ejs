<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title && title !== 'FFM' ? title + ' · FFM' : 'FFM' %></title>
    <meta name="description"
      content="FFM - India's competitive Free Fire tournament platform with paid scrims, verified hosts, and instant prize settlement.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800;900&family=Chakra+Petch:wght@500;600;700&family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet">
    <link rel="icon" type="image/png" href="/img/logo.png">
    <link rel="stylesheet" href="/css/app.css">
  </head>
  <body class="bg-black">
    <%- include('../partials/navbar') %>
    <main class="min-h-screen pb-20 md:pb-0">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
    <%- include('../partials/mobilenav') %>
    <script src="/js/app.js" defer></script>
  </body>
</html>