<%- include('../partials/admin-open') %>
<% const isEdit = !!edit; const f = form || {}; %>

<div>
  <a href="/admin/matches"
    class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#8a7d63] hover:text-amber-400 mb-2 transition">
    <%- icon('arrow-left', 'h-3.5 w-3.5') %> Back to matches
  </a>
  <h1 class="h1"><%= isEdit ? 'Edit Match ' + edit.publicMatchCode :
    'Create Match' %></h1>
  <p class="text-xs text-[#8a7d63] mt-1">Times are in your configured timezone
    (default Asia/Kolkata, IST).</p>
</div>

<!-- ERRORS -->
<% if (errors && errors.length) { %>
<div
  class="rounded-lg bg-rose-500/10 border border-rose-500/30 p-3 text-xs font-semibold text-rose-400 space-y-1">
  <% errors.forEach(function (e) { %>
  <div class="flex items-center gap-2">
    <%- icon('circle-alert', 'h-4 w-4 shrink-0') %> <%= e %>
  </div>
  <% }) %>
</div>
<% } %>

<form method="post"
  action="<%= isEdit ? '/admin/matches/' + edit._id + '/edit' : '/admin/matches/create' %>"
  class="card border-amber-500/20 bg-[#0f0c08]/80 backdrop-blur-sm p-6 space-y-6">

  <!-- BASIC DETAILS -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="label" for="mode">Game Mode</label>
      <select id="mode" name="mode" data-mode-select class="input">
        <% modes.forEach(function (m) { %>
        <option value="<%= m.slug %>" data-max="<%= m.maxPlayers %>" <%=f.mode
          === m.slug ? 'selected' : '' %>><%= m.name %></option>
        <% }) %>
      </select>
    </div>

    <div>
      <label class="label" for="map_name">Map</label>
      <select id="map_name" name="map_name" class="input">
        <% maps.forEach(function (m) { %>
        <option <%=f.map_name === m ? 'selected' : '' %>><%= m %></option>
        <% }) %>
      </select>
    </div>

    <div>
      <label class="label" for="entry_fee">
        <%- icon('coins', 'inline h-3.5 w-3.5 -mt-0.5') %> Entry Fee (₹)
      </label>
      <input id="entry_fee" name="entry_fee" type="number" min="0" step="1"
        required value="<%= f.entry_fee %>" class="input" <%=isEdit &&
        edit.registrationCount> 0 ? 'readonly' : '' %>>
    </div>

    <div>
      <label class="label" for="prize_pool">
        <%- icon('trophy', 'inline h-3.5 w-3.5 -mt-0.5') %> Prize Pool (₹)
      </label>
      <input id="prize_pool" name="prize_pool" type="number" min="0" step="1"
        required value="<%= f.prize_pool %>" class="input">
    </div>

    <!-- PLAYER-BASED MODE: MAX PLAYERS -->
    <div id="max-players-wrap" class="<%= isTournamentForm ? 'hidden' : '' %>">
      <label class="label" for="max_players">
        <%- icon('users', 'inline h-3.5 w-3.5 -mt-0.5') %> Max Players
      </label>
      <input id="max_players" name="max_players" type="number" min="2" max="100"
        value="<%= f.max_players %>" class="input">
    </div>

    <!-- TOURNAMENT MODE: MAX TEAMS -->
    <div id="max-teams-wrap" class="<%= isTournamentForm ? '' : 'hidden' %>">
      <label class="label" for="max_teams">
        <%- icon('users', 'inline h-3.5 w-3.5 -mt-0.5') %> Max Teams
      </label>
      <input id="max_teams" name="max_teams" type="number" min="2" max="24"
        value="<%= f.max_teams || 12 %>" class="input">
      <p class="text-[10px] text-[#8a7d63] mt-1">Number of squad slots
        (2-24).</p>
    </div>
  </div>

  <!-- SCHEDULE -->
  <div>
    <h2
      class="text-xs font-extrabold uppercase tracking-wider text-amber-400 mb-3 flex items-center gap-1.5">
      <%- icon('calendar', 'h-4 w-4') %> Schedule
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="label" for="registration_start_at">Registration
          Opens</label>
        <input id="registration_start_at" name="registration_start_at"
          type="datetime-local" required value="<%= f.registration_start_at %>"
          class="input">
      </div>
      <div>
        <label class="label" for="registration_close_at">Registration
          Closes</label>
        <input id="registration_close_at" name="registration_close_at"
          type="datetime-local" required value="<%= f.registration_close_at %>"
          class="input">
      </div>
      <div>
        <label class="label" for="room_release_at">Room Release</label>
        <input id="room_release_at" name="room_release_at" type="datetime-local"
          required value="<%= f.room_release_at %>" class="input">
      </div>
      <div>
        <label class="label" for="match_start_at">Match Start</label>
        <input id="match_start_at" name="match_start_at" type="datetime-local"
          required value="<%= f.match_start_at %>" class="input">
      </div>
    </div>
  </div>

  <!-- TOURNAMENT EXTRA FIELDS -->
  <div id="tournament-extra"
    class="<%= isTournamentForm ? '' : 'hidden' %> space-y-4">
    <h2
      class="text-xs font-extrabold uppercase tracking-wider text-amber-400 mb-3 flex items-center gap-1.5">
      <%- icon('trophy', 'h-4 w-4') %> Tournament Details
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="label" for="tournament_name">Tournament Name</label>
        <input id="tournament_name" name="tournament_name" type="text"
          maxlength="80"
          value="<%= f.tournament_name || '' %>"
          placeholder="FFM BR Squad Championship #1" class="input">
      </div>

      <div>
        <label class="label" for="total_matches">Total Matches</label>
        <input id="total_matches" name="total_matches" type="number" min="1"
          max="20"
          value="<%= f.total_matches || 6 %>" class="input">
        <p class="text-[10px] text-[#8a7d63] mt-1">Number of matches per
          tournament (1-20).</p>
      </div>

      <div>
        <label class="label" for="team_size">Team Size</label>
        <input id="team_size" name="team_size" type="number" min="2" max="6"
          value="<%= f.team_size || 4 %>" class="input">
        <p class="text-[10px] text-[#8a7d63] mt-1">Players per squad (2-6).</p>
      </div>
    </div>

    <div>
      <label class="label" for="tournament_description">Tournament Description
        (optional)</label>
      <textarea id="tournament_description" name="tournament_description"
        rows="2" maxlength="500"
        placeholder="Rules, format, and prize details..."
        class="input"><%= f.tournament_description || '' %></textarea>
    </div>
  </div>

  <!-- ROOM CREDENTIALS -->
  <div>
    <h2
      class="text-xs font-extrabold uppercase tracking-wider text-amber-400 mb-3 flex items-center gap-1.5">
      <%- icon('key', 'h-4 w-4') %> Custom Room (encrypted, shown to joined
      players at release time)
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="label" for="room_id">Room ID</label>
        <input id="room_id" name="room_id" value="<%= f.room_id || '' %>"
          class="input font-mono" autocomplete="off">
      </div>
      <div>
        <label class="label" for="room_password">Room Password</label>
        <input id="room_password" name="room_password"
          value="<%= f.room_password || '' %>"
          class="input font-mono" autocomplete="off">
      </div>
    </div>
  </div>

  <!-- POINT TABLES (only for BR Squad & edit mode) -->
  <% if (isEdit && isTournamentForm) { %>
  <div id="point-tables-section" class="space-y-4">
    <h2
      class="text-xs font-extrabold uppercase tracking-wider text-amber-400 mb-3 flex items-center gap-1.5">
      <%- icon('image', 'h-4 w-4') %> Point Table Images (12 total)
    </h2>
    <p class="text-[11px] text-[#8a7d63]">
      Upload 2 images per match — 1 Free Fire screenshot + 1 your custom point
      table.
    </p>

    <div class="space-y-3">
      <% for (let m = 1; m <= (edit.totalMatches || 6); m++) { %>
      <% const existing = edit.groupedPointTables()[m] || {}; %>
      <div class="rounded-xl border border-amber-500/20 bg-black/40 p-4">
        <div
          class="flex items-center justify-between mb-3 pb-2 border-b border-amber-500/15">
          <div class="flex items-center gap-2">
            <div
              class="flex h-7 w-7 items-center justify-center rounded bg-gradient-to-br from-amber-300 to-amber-600 text-black font-black text-xs">
              <%= m %>
            </div>
            <h3
              class="font-black text-white text-sm uppercase tracking-tight">Match
              <%= m %></h3>
          </div>
          <%
          const ffUploaded = !!existing.FF_SCREENSHOT;
          const ptUploaded = !!existing.POINT_TABLE;
          const bothDone = ffUploaded && ptUploaded;
          %>
          <span
            class="rounded-full px-2 py-0.5 text-[10px] font-black uppercase tracking-wider <%= bothDone ? 'bg-emerald-500/15 border border-emerald-500/40 text-emerald-400' : 'bg-amber-500/15 border border-amber-500/40 text-amber-400' %>">
            <%= bothDone ? 'Complete' : (ffUploaded || ptUploaded) ? 'Partial' :
            'Pending' %>
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- FREE FIRE SCREENSHOT -->
          <div>
            <label
              class="text-[10px] font-bold uppercase tracking-wider text-[#8a7d63] block mb-2">
              <%- icon('image', 'h-3 w-3 inline -mt-0.5') %> FF Screenshot
            </label>
            <% if (ffUploaded) { %>
            <div class="relative group">
              <img src="<%= existing.FF_SCREENSHOT.url %>"
                alt="FF Screenshot Match <%= m %>"
                class="w-full h-32 object-cover rounded-lg border border-emerald-500/40">
              <div
                class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition rounded-lg flex items-center justify-center">
                <form method="post"
                  action="/admin/matches/<%= edit._id %>/point-table/<%= m %>/FF_SCREENSHOT/delete"
                  data-confirm="Delete this image?">
                  <button type="submit"
                    class="rounded-md bg-rose-500/20 border border-rose-500/40 px-3 py-1.5 text-xs font-bold text-rose-300 hover:bg-rose-500/30 transition">
                    <%- icon('trash-2', 'h-3.5 w-3.5 inline -mt-0.5') %> Delete
                  </button>
                </form>
              </div>
            </div>
            <% } else { %>
            <form method="post"
              action="/admin/matches/<%= edit._id %>/point-table"
              enctype="multipart/form-data">
              <input type="hidden" name="match_number" value="<%= m %>">
              <input type="hidden" name="image_type" value="FF_SCREENSHOT">
              <label
                class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-amber-500/30 rounded-lg cursor-pointer hover:border-amber-500/60 hover:bg-amber-500/5 transition">
                <%- icon('upload', 'h-6 w-6 text-amber-400 mb-2') %>
                <span class="text-xs font-bold text-[#e8dfc9]">Upload
                  Screenshot</span>
                <span class="text-[10px] text-[#8a7d63] mt-1">JPG/PNG · max
                  5MB</span>
                <input type="file" name="image" accept="image/*" required
                  data-auto-submit class="hidden">
              </label>
            </form>
            <% } %>
          </div>

          <!-- POINT TABLE -->
          <div>
            <label
              class="text-[10px] font-bold uppercase tracking-wider text-[#8a7d63] block mb-2">
              <%- icon('table', 'h-3 w-3 inline -mt-0.5') %> Point Table
            </label>
            <% if (ptUploaded) { %>
            <div class="relative group">
              <img src="<%= existing.POINT_TABLE.url %>"
                alt="Point Table Match <%= m %>"
                class="w-full h-32 object-cover rounded-lg border border-emerald-500/40">
              <div
                class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition rounded-lg flex items-center justify-center">
                <form method="post"
                  action="/admin/matches/<%= edit._id %>/point-table/<%= m %>/POINT_TABLE/delete"
                  data-confirm="Delete this image?">
                  <button type="submit"
                    class="rounded-md bg-rose-500/20 border border-rose-500/40 px-3 py-1.5 text-xs font-bold text-rose-300 hover:bg-rose-500/30 transition">
                    <%- icon('trash-2', 'h-3.5 w-3.5 inline -mt-0.5') %> Delete
                  </button>
                </form>
              </div>
            </div>
            <% } else { %>
            <form method="post"
              action="/admin/matches/<%= edit._id %>/point-table"
              enctype="multipart/form-data">
              <input type="hidden" name="match_number" value="<%= m %>">
              <input type="hidden" name="image_type" value="POINT_TABLE">
              <label
                class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-amber-500/30 rounded-lg cursor-pointer hover:border-amber-500/60 hover:bg-amber-500/5 transition">
                <%- icon('upload', 'h-6 w-6 text-amber-400 mb-2') %>
                <span class="text-xs font-bold text-[#e8dfc9]">Upload Point
                  Table</span>
                <span class="text-[10px] text-[#8a7d63] mt-1">JPG/PNG · max
                  5MB</span>
                <input type="file" name="image" accept="image/*" required
                  data-auto-submit class="hidden">
              </label>
            </form>
            <% } %>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- RULES -->
  <div>
    <label class="label" for="rules_text">Match Rules (optional)</label>
    <textarea id="rules_text" name="rules_text" rows="3" maxlength="2000"
      class="input"><%= f.rules_text || '' %></textarea>
  </div>

  <!-- ACTIONS -->
  <div class="flex gap-3">
    <button type="submit"
      class="btn-primary bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-black font-black border border-amber-400 shadow-[0_0_24px_-6px_rgba(245,200,66,0.7)]">
      <%= isEdit ? 'Save Changes' : 'Create Match' %>
    </button>
    <a href="/admin/matches"
      class="btn-ghost border-amber-500/30 text-amber-300 hover:bg-amber-500/10 hover:border-amber-400">
      Cancel
    </a>
  </div>
</form>

<%- include('../partials/admin-close') %>