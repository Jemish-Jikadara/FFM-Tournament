<%- include('../partials/admin-open') %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
  <div>
    <h1 class="h1">User Accounts</h1>
    <p class="text-xs text-[#8a7d63] mt-1">Showing up to 100 users</p>
  </div>
  <form method="get" action="/admin/users" class="flex gap-2">
    <input name="q" value="<%= q %>" placeholder="Search email, name, UID…"
      class="input !w-64">
    <button
      class="btn-ghost border-amber-500/30 text-amber-300 hover:bg-amber-500/10 hover:border-amber-400"
      type="submit">
      <%- icon('search', 'h-3.5 w-3.5') %> Search
    </button>
  </form>
</div>

<div
  class="card border-amber-500/20 bg-[#0f0c08]/80 backdrop-blur-sm overflow-hidden">
  <% if (!users.length) { %>
  <div class="p-10 text-center text-xs text-[#8a7d63]">No users found.</div>
  <% } else { %>
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-black/60 border-b border-amber-500/20">
        <tr>
          <th class="th text-amber-400">User</th>
          <th class="th text-amber-400">UID</th>
          <th class="th text-amber-400">Role</th>
          <th class="th text-amber-400">Status</th>
          <th class="th text-amber-400">Joined</th>
          <th class="th text-amber-400">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-amber-500/10">
        <% users.forEach(function (u) { const me = String(u._id) ===
        String(user._id); %>
        <tr class="hover:bg-amber-500/[0.03] transition">
          <td class="td">
            <span class="font-bold text-[#e8dfc9]"><%= u.profile.displayName ||
              '—' %></span><br>
            <span class="text-[#8a7d63]"><%= u.email %></span>
          </td>
          <td class="td font-mono text-[#a89878]"><%= u.profile.freeFireUid ||
            '—' %></td>
          <td class="td">
            <% if (isSuper && !me) { %>
            <form method="post" action="/admin/users/<%= u._id %>/role"
              class="flex gap-1">
              <select name="role" data-autosubmit
                class="input !py-1 !text-xs !w-32">
                <% roles.forEach(function (r) { %>
                <option <%=u.role === r ? 'selected' : '' %>><%= r %></option>
                <% }) %>
              </select>
            </form>
            <% } else { %>
            <span
              class="rounded-full px-2 py-0.5 text-[10px] font-bold uppercase <%= roleBadge(u.role) %>"><%=
              u.role %></span>
            <% } %>
          </td>
          <td class="td">
            <span
              class="rounded-full px-2 py-0.5 text-[10px] font-bold uppercase <%= stateBadge(u.status) %>"><%=
              u.status %></span>
          </td>
          <td class="td whitespace-nowrap text-[#a89878]"><%= date(u.createdAt)
            %></td>
          <td class="td">
            <% if (!me) { %>
            <form method="post" action="/admin/users/<%= u._id %>/status"
              class="flex gap-1.5">
              <% if (u.status !== 'ACTIVE') { %>
              <button name="status" value="ACTIVE"
                class="btn-primary !py-1 !px-2.5 bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-black font-black border border-amber-400 shadow-[0_0_16px_-4px_rgba(245,200,66,0.7)]"
                type="submit">Activate</button>
              <% } %>
              <% if (u.status === 'ACTIVE') { %>
              <button name="status" value="SUSPENDED"
                class="btn-ghost !py-1 !px-2.5 border-amber-500/30 text-amber-300 hover:bg-amber-500/10 hover:border-amber-400"
                type="submit">Suspend</button>
              <button name="status" value="BANNED"
                class="btn-danger !py-1 !px-2.5" type="submit">Ban</button>
              <% } %>
            </form>
            <% } else { %>
            <span class="text-[#8a7d63] italic">You</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<%- include('../partials/admin-close') %>