<div class="py-8 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="h1">Notifications</h1>
      <p class="text-xs text-[#8a7d63] mt-1">Match, wallet and account updates</p>
    </div>
    <% if (items.some(function (n) { return !n.read; })) { %>
      <form method="post" action="/notifications/read-all">
        <button class="btn-ghost border-amber-500/30 text-amber-300 hover:bg-amber-500/10 hover:border-amber-400" type="submit">
          <%- icon('check', 'h-3.5 w-3.5') %> Mark all read
        </button>
      </form>
    <% } %>
  </div>

  <% if (!items.length) { %>
    <div class="rounded-2xl border border-amber-500/20 bg-black/60 backdrop-blur-sm p-12 text-center">
      <%- icon('bell', 'mx-auto h-10 w-10 text-amber-500/40 mb-3') %>
      <p class="text-sm font-semibold text-[#8a7d63]">You're all caught up.</p>
    </div>
  <% } else { %>
    <div class="rounded-xl border border-amber-500/20 bg-[#0f0c08]/80 backdrop-blur-sm overflow-hidden divide-y divide-amber-500/10">
      <% items.forEach(function (n) { %>
        <div class="flex items-start justify-between gap-3 p-4 transition <%= n.read ? 'opacity-60' : 'bg-amber-500/[0.05]' %>">
          <div class="flex items-start gap-3">
            <span class="mt-1.5 h-2 w-2 rounded-full shrink-0 <%= n.read ? 'bg-white/20' : 'bg-amber-400 shadow-[0_0_8px_rgba(245,200,66,0.8)]' %>"></span>
            <div>
              <p class="text-sm font-bold text-white"><%= n.title %></p>
              <p class="text-xs text-[#a89878] mt-0.5"><%= n.message %></p>
              <p class="text-[11px] text-[#8a7d63] mt-1"><%= date(n.createdAt) %></p>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <% if (n.link) { %>
              <form method="post" action="/notifications/<%= n._id %>/read">
                <input type="hidden" name="to" value="<%= n.link %>">
                <button class="text-xs font-bold text-amber-400 hover:text-amber-300 cursor-pointer transition" type="submit">Open</button>
              </form>
            <% } else if (!n.read) { %>
              <form method="post" action="/notifications/<%= n._id %>/read">
                <button class="text-xs font-bold text-[#8a7d63] hover:text-amber-400 cursor-pointer transition" type="submit">Mark read</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>