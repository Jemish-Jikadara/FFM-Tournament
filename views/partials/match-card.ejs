<%
const st = m.displayStatus();
const cur = m.currentPlayers();
const isFull = cur >= m.maxPlayers;
const isDone = st === 'COMPLETED' || st === 'CANCELLED';
const isLive = st === 'IN_PROGRESS' || st === 'ROOM_READY';
const reg = !!user && m.isRegistered(user._id);
const pct = Math.min(100, Math.round((cur / m.maxPlayers) * 100));
%>
<div
  class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-amber-500/20 bg-gradient-to-b from-[#0f0c08]/90 to-black/90 backdrop-blur-sm p-5 transition-all duration-200 hover:border-amber-500/50 hover:from-[#141009]/90 hover:to-[#0a0806]/90 shadow-lg shadow-black/40 hover:shadow-[0_0_40px_-15px_rgba(245,200,66,0.4)]">
  <div>
    <!-- TOP ROW: Mode badge + Status -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <div
        class="flex items-center gap-1.5 rounded-md bg-amber-500/10 border border-amber-500/30 px-2.5 py-1 text-xs font-bold text-amber-300 uppercase tracking-wider">
        <%- icon('swords', 'h-3.5 w-3.5 text-amber-400') %>
        <span><%= m.modeName %></span>
      </div>
      <div class="flex items-center gap-2">
        <% if (reg) { %>
        <span
          class="rounded-full bg-amber-500/15 border border-amber-500/40 px-2 py-0.5 text-[11px] font-bold text-amber-300">REGISTERED</span>
        <% } %>
        <span
          class="rounded-full px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider <%= statusPill(st) %>"><%=
          statusLabel(st) %></span>
      </div>
    </div>

    <!-- MAP + MATCH CODE -->
    <div class="flex items-center justify-between text-xs text-[#a89878] mb-4">
      <div class="flex items-center gap-1">
        <%- icon('map-pin', 'h-3.5 w-3.5 text-[#8a7d63]') %>
        <span>Map: <strong class="text-[#e8dfc9] font-semibold"><%= m.mapName
            %></strong></span>
      </div>
      <span class="font-mono text-[#8a7d63] font-medium"><%= m.publicMatchCode
        %></span>
    </div>

    <!-- ENTRY FEE + PRIZE POOL -->
    <div
      class="grid grid-cols-2 gap-2.5 rounded-lg border border-amber-500/15 bg-black/60 p-3 mb-4">
      <div>
        <span
          class="flex items-center gap-1 text-[11px] font-semibold text-[#8a7d63] uppercase tracking-wider">
          <%- icon('coins', 'h-3 w-3 text-[#8a7d63]') %> Entry Fee
        </span>
        <span class="text-base font-extrabold text-white"><%= m.entryFeePaise
          === 0 ? 'FREE' : paise(m.entryFeePaise) %></span>
      </div>
      <div>
        <span
          class="flex items-center gap-1 text-[11px] font-semibold text-[#8a7d63] uppercase tracking-wider">
          <%- icon('trophy', 'h-3 w-3 text-amber-400') %> Prize Pool
        </span>
        <span
          class="text-base font-extrabold bg-gradient-to-r from-amber-200 to-amber-500 bg-clip-text text-transparent"><%=
          paise(m.prizePoolPaise) %></span>
      </div>
    </div>

    <!-- SLOTS PROGRESS -->
    <div class="mb-4">
      <div class="flex items-center justify-between text-xs mb-1.5">
        <span class="flex items-center gap-1 text-[#a89878]">
          <%- icon('users', 'h-3.5 w-3.5 text-[#8a7d63]') %> Slots
        </span>
        <span class="font-bold font-mono text-[#e8dfc9]"><%= cur %> / <%=
          m.maxPlayers %></span>
      </div>
      <div
        class="h-2 w-full overflow-hidden rounded-full bg-black/60 border border-amber-500/10">
        <div
          class="h-full transition-all duration-300 <%= isFull ? 'bg-gradient-to-r from-amber-400 to-amber-600' : 'bg-gradient-to-r from-amber-300 to-amber-500' %>"
          style="width: <%= pct %>%"></div>
      </div>
    </div>
  </div>

  <!-- FOOTER: TIMER + CTA -->
  <div
    class="border-t border-amber-500/15 pt-3.5 mt-1 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <% if (!isDone && !isLive) { %>
      <div class="flex items-center gap-1.5 font-mono text-xs text-[#e8dfc9]">
        <%- icon('clock', 'h-3.5 w-3.5 text-amber-400') %>
        <span class="text-[#8a7d63]">Starts in:</span>
        <span class="font-bold text-amber-400"
          data-countdown="<%= m.matchStartAt.toISOString() %>"
          data-reload>--:--:--</span>
      </div>
      <% } else if (isLive) { %>
      <span
        class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-amber-400 animate-ping"></span>
        Match in Progress
      </span>
      <% } else if (st === 'CANCELLED') { %>
      <span class="text-xs font-semibold text-rose-400">Cancelled</span>
      <% } else { %>
      <span class="text-xs font-semibold text-[#8a7d63]">Completed &amp;
        Settled</span>
      <% } %>
    </div>

    <a href="/matches/<%= m._id %>"
      class="text-center rounded-lg px-4 py-2 text-xs font-bold tracking-wider uppercase transition shadow-sm
       <%= reg
            ? 'bg-amber-500/10 text-amber-300 border border-amber-500/40 hover:bg-amber-500/20'
            : (isDone || isFull)
              ? 'bg-white/5 text-[#8a7d63] border border-white/10 hover:bg-white/10 hover:text-amber-300'
              : 'bg-gradient-to-b from-amber-300 to-amber-500 text-black border border-amber-400 hover:from-amber-200 hover:to-amber-400 shadow-[0_0_24px_-6px_rgba(245,200,66,0.7)]' %>">
      <%= reg ? 'View Match Room' : isDone ? 'View Results' : (isFull || st ===
      'REGISTRATION_CLOSED') ? 'View Match' : 'Join Match' %>
    </a>
  </div>
</div>