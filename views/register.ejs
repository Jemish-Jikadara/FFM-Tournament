<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center p-4">
  <div
    class="w-full max-w-lg rounded-2xl border border-amber-500/20 bg-[#0f0c08]/80 p-8 shadow-2xl backdrop-blur-md">
    <div class="text-center mb-8">
      <div class="mx-auto flex h-16 w-16 items-center justify-center mb-4">
        <img src="/img/logo.png" alt="FFM" class="w-full h-full object-contain"
          draggable="false" />
      </div>
      <h1 class="text-2xl font-black text-white uppercase tracking-tight">Create
        Player Profile</h1>
      <p class="text-xs text-[#8a7d63] mt-1">Link your Free Fire UID to
        participate in scheduled matches</p>
    </div>

    <% if (error) { %>
    <div
      class="mb-5 flex items-center gap-2 rounded-lg bg-rose-500/10 border border-rose-500/30 p-3 text-xs font-semibold text-rose-400">
      <%- icon('circle-alert', 'h-4 w-4 shrink-0') %>
      <span><%= error %></span>
    </div>
    <% } %>

    <form method="post" action="/register" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="label" for="display_name">Display Name</label>
          <div class="relative">
            <%- icon('user',
            'absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-[#8a7d63]')
            %>
            <input id="display_name" name="display_name" type="text" required
              maxlength="30" value="<%= form.displayName || '' %>"
              placeholder="Viper_99" class="input input-icon">
          </div>
        </div>
        <div>
          <label class="label" for="email">Email Address</label>
          <div class="relative">
            <%- icon('mail',
            'absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-[#8a7d63]')
            %>
            <input id="email" name="email" type="email" required
              autocomplete="email" value="<%= form.email || '' %>"
              placeholder="player@freefire.gg" class="input input-icon">
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="label !text-amber-400" for="free_fire_uid">Free Fire
            UID</label>
          <div class="relative">
            <%- icon('gamepad-2',
            'absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-amber-400')
            %>
            <input id="free_fire_uid" name="free_fire_uid" type="text"
              inputmode="numeric" pattern="\d{5,15}" required
              value="<%= form.uid || '' %>" placeholder="e.g. 194820194"
              class="input input-icon !border-amber-500/40 font-mono">
          </div>
        </div>
        <div>
          <label class="label !text-amber-400" for="free_fire_name">Free Fire
            Nickname</label>
          <div class="relative">
            <%- icon('gamepad-2',
            'absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-amber-400')
            %>
            <input id="free_fire_name" name="free_fire_name" type="text"
              required maxlength="40" value="<%= form.ign || '' %>"
              placeholder="Exact in-game name"
              class="input input-icon !border-amber-500/40">
          </div>
        </div>
      </div>
      <div>
        <label class="label" for="phone">Phone (optional)</label>
        <input id="phone" name="phone" type="tel"
          value="<%= form.phone || '' %>" placeholder="+91 98765 43210"
          class="input">
      </div>
      <div>
        <label class="label" for="password">Password</label>
        <div class="relative">
          <%- icon('lock',
          'absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-[#8a7d63]')
          %>
          <input id="password" name="password" type="password" required
            minlength="6" autocomplete="new-password"
            placeholder="At least 6 characters" class="input input-icon">
        </div>
      </div>
      <p class="text-[11px] text-[#8a7d63] leading-normal">By clicking Register,
        you confirm that you are at least 18 years old and agree to follow all
        platform Fair Play rules.</p>
      <button type="submit"
        class="btn-primary w-full mt-2 py-3 bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-black font-black shadow-[0_0_30px_-5px_rgba(245,200,66,0.7)] border border-amber-400">
        Register &amp; Start Playing <%- icon('arrow-right', 'h-4 w-4') %>
      </button>
    </form>

    <div class="mt-6 text-center text-xs text-[#8a7d63]">
      Already registered? <a href="/login"
        class="font-bold text-amber-400 hover:text-amber-300">Sign In Here</a>
    </div>
  </div>
</div>