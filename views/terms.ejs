<div class="py-8 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-6">
  <a href="/"
    class="inline-flex items-center gap-1.5 text-xs text-[#8a7d63] hover:text-amber-400 transition">
    <%- icon('arrow-left', 'h-4 w-4') %> Back to Home
  </a>
  <div
    class="rounded-2xl border border-amber-500/20 bg-[#0f0c08]/80 backdrop-blur-sm p-8 space-y-6">
